# Copy to .env for local dev (.env is gitignored).
# Note: the binary reads process env vars only — it does NOT auto-load .env.
# Load it with:  set -a; source .env; set +a; cargo run

# Required
PARALLEL_API_KEY=sk-your-parallel-key

# Auth for this service's own clients (optional; unset = open endpoint)
#SEARCH_API_KEY=choose-a-strong-shared-key

# Caching
#CACHE_TTL_SECS=300            # biggest cost lever; raise if staleness is OK
#CACHE_TTL_VOLATILE_SECS=120   # TTL for time-sensitive queries (weather, prices, scores…)
#CACHE_MAX_BYTES=268435456     # in-process cache cap (256 MiB)
#CDN_CACHE=public              # public | private | off (default: auto from SEARCH_API_KEY)

# Upstream
#PARALLEL_BASE_URL=https://api.parallel.ai
#DEFAULT_MODE=turbo            # turbo | fast | basic | advanced
#REQUEST_TIMEOUT_SECS=30

# Server
#PORT=8080
#HOST=0.0.0.0
#TOKIO_WORKER_THREADS=4        # keep small; Bunny hosts expose 32+ cores
#RUST_LOG=info
